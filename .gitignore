# PHP / Composer
# INCLUDE production vendor for "plug-and-play"
vendor/
!vendor/**/
!vendor/**/*.php
!vendor/**/*.json

# EXCLUDE Development/Testing tools (Huge volume of files)
vendor/phpunit/
vendor/mockery/
vendor/brain/
vendor/hamcrest/
vendor/myclabs/
vendor/nikic/
vendor/phar-io/
vendor/sebastian/
vendor/theseer/
vendor/antecedent/
vendor/staabm/
vendor/bin/

# Exclude obvious bloat within production packages
vendor/**/tests/
vendor/**/test/
vendor/**/Test/
vendor/**/Documentation/
vendor/**/docs/
vendor/**/*.md
vendor/**/phpunit.xml*
vendor/**/.github/
vendor/**/CHANGELOG*
vendor/**/CONTRIBUTING*

# PHP environment
composer.phar
.phpunit.result.cache
patchwork.json

# PhpStorm
.idea

# Various overrides
docker-compose.override.yml
phpunit.xml
wp-cli.local.yml

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
