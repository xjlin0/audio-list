# PHP / Composer
# We INCLUDE vendor for "plug-and-play" but exclude unnecessary bloat
!vendor/
vendor/**/tests/
vendor/**/test/
vendor/**/Test/
vendor/**/Documentation/
vendor/**/docs/
vendor/**/*.md
vendor/**/phpunit.xml*
vendor/**/.github/
vendor/**/CHANGELOG*
vendor/**/CONTRIBUTING*

# PHP environment
composer.phar
.phpunit.result.cache

# PhpStorm
.idea

# Various overrides
docker-compose.override.yml
phpunit.xml
wp-cli.local.yml

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
