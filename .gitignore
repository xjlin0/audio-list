# PHP / Composer
# 1. Allow the vendor directory itself so Git scans it
!vendor/

# 2. Ignore everything inside vendor by default
vendor/*

# 3. Explicitly ALLOW production-essential directories and files
!vendor/autoload.php
!vendor/composer/
!vendor/async-aws/
!vendor/symfony/
!vendor/psr/

# 4. EXCLUDE huge development/testing bloat inside those allowed folders
vendor/**/tests/
vendor/**/test/
vendor/**/Test/
vendor/**/Documentation/
vendor/**/docs/
vendor/**/*.md
vendor/**/phpunit.xml*
vendor/**/.github/
vendor/**/CHANGELOG*
vendor/**/CONTRIBUTING*

# PHP environment artifacts
composer.phar
.phpunit.result.cache
patchwork.json

# PhpStorm
.idea

# Various overrides
docker-compose.override.yml
phpunit.xml
wp-cli.local.yml

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
